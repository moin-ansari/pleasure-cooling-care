# Supabase Postgres. Password special characters must be percent-encoded (@ -> %40, * -> %2A, $ -> %24).
# Transaction pooler (port 6543) is used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler (port 5432) is used by `prisma migrate`.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Long random string used to sign login tokens.
SECRET_TOKEN=""
# Secret code required on /signup to create an admin account.
ADMIN_ACCESS_TOKEN=""

# SMS through MSG91 (India needs DLT-approved templates first). Leave these empty and the app still works:
# messages are recorded in Admin > Messages but not sent.
MSG91_AUTH_KEY=""
# One MSG91 template id per message. Each template uses variables var1, var2, ... in the order listed in src/constants/sms.ts
MSG91_TEMPLATE_BOOKING_RECEIVED=""
MSG91_TEMPLATE_BOOKING_CONFIRMED=""
MSG91_TEMPLATE_TECHNICIAN_ARRIVING=""
MSG91_TEMPLATE_BOOKING_DELAYED=""
MSG91_TEMPLATE_BOOKING_COMPLETED=""
MSG91_TEMPLATE_BOOKING_CANCELLED=""
MSG91_TEMPLATE_PRICE_CHANGED=""
MSG91_TEMPLATE_TECHNICIAN_ASSIGNED=""
MSG91_TEMPLATE_TECHNICIAN_REMOVED=""
MSG91_TEMPLATE_ADMIN_NEW_BOOKING=""
MSG91_TEMPLATE_WARRANTY_APPROVED=""
MSG91_TEMPLATE_WARRANTY_REJECTED=""
MSG91_TEMPLATE_ADMIN_WARRANTY_CLAIM=""
MSG91_TEMPLATE_ADMIN_REASSIGN_REQUEST=""
# Optional: number to SMS on every new booking (also settable in Admin > Messages).
ADMIN_ALERT_PHONE=""

# Image storage (Supabase Storage). Create a PUBLIC bucket and use the service role key.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="pcc-public"
# A PRIVATE bucket for ID documents. Never make it public.
SUPABASE_PRIVATE_BUCKET="pcc-private"
