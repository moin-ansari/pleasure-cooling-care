# Supabase Postgres. Password special characters must be percent-encoded (@ -> %40, * -> %2A, $ -> %24).
# Transaction pooler (port 6543) is used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler (port 5432) is used by `prisma migrate`.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Long random string used to sign login tokens.
SECRET_TOKEN=""
# Secret code required on /signup to create an admin account.
ADMIN_ACCESS_TOKEN=""
